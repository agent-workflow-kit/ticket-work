{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticket-work/cli/prune.json",
  "type": "object",
  "properties": {
    "dry_run": {
      "type": "boolean"
    },
    "removed": {
      "type": "object",
      "properties": {
        "work_items": {
          "type": "integer",
          "minimum": 0
        },
        "links": {
          "type": "integer",
          "minimum": 0
        },
        "pending_resolved": {
          "type": "integer",
          "minimum": 0
        },
        "pending_expired": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "work_items",
        "links",
        "pending_resolved",
        "pending_expired"
      ]
    },
    "skipped": {
      "type": "integer",
      "minimum": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/note"
      },
      "maxItems": 256
    }
  },
  "additionalProperties": false,
  "required": [
    "dry_run",
    "removed",
    "skipped",
    "warnings"
  ],
  "description": "Counts of what was (or with --dry-run would be) removed; skipped counts finished items kept because their cleanup is unfinished; warnings carry agent_left.",
  "title": "prune --json"
}
