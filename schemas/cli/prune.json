{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticket-work/cli/prune.json",
  "type": "object",
  "properties": {
    "dry_run": {
      "type": "boolean"
    },
    "removed": {
      "type": "object",
      "properties": {
        "work_items": {
          "type": "integer",
          "minimum": 0
        },
        "links": {
          "type": "integer",
          "minimum": 0
        },
        "pending_resolved": {
          "type": "integer",
          "minimum": 0
        },
        "pending_expired": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "work_items",
        "links",
        "pending_resolved",
        "pending_expired"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "dry_run",
    "removed"
  ],
  "description": "Counts of what was (or with --dry-run would be) removed.",
  "title": "prune --json"
}
