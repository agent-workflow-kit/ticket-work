{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticket-work/hooks/pre-enqueue.json",
  "title": "pre-enqueue hook payload (stdin)",
  "description": "pre- hook payload (stdin): exit 0 continues, exit 13 escalates, any other non-zero vetoes. No ticket, pull request or model text. Consumers tolerate unknown keys.",
  "type": "object",
  "properties": {
    "tool": {
      "const": "ticket-work"
    },
    "hook": {
      "const": "pre-enqueue"
    },
    "object_type": {
      "const": "work"
    },
    "object_id": {
      "$ref": "../defs.json#/$defs/work_id"
    },
    "repo": {
      "$ref": "../defs.json#/$defs/repo_id"
    },
    "labels": {
      "$ref": "../defs.json#/$defs/labels"
    },
    "board": {
      "$ref": "../defs.json#/$defs/board_name"
    },
    "site": {
      "$ref": "../defs.json#/$defs/site_name"
    },
    "key": {
      "$ref": "../defs.json#/$defs/key"
    },
    "phase": {
      "$ref": "../defs.json#/$defs/phase"
    },
    "actor": {
      "$ref": "../defs.json#/$defs/actor"
    }
  },
  "additionalProperties": false,
  "required": [
    "tool",
    "hook",
    "object_type",
    "object_id",
    "repo",
    "labels",
    "board",
    "site",
    "key",
    "phase",
    "actor"
  ]
}
