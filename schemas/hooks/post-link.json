{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticket-work/hooks/post-link.json",
  "title": "post-link hook payload (stdin)",
  "description": "post- hook payload (stdin): delivered at least once through the outbox; deduplicate on event_id; failure is never fatal. No ticket, pull request or model text. Consumers tolerate unknown keys.",
  "type": "object",
  "properties": {
    "tool": {
      "const": "ticket-work"
    },
    "hook": {
      "const": "post-link"
    },
    "event_id": {
      "$ref": "../defs.json#/$defs/event_id"
    },
    "object_type": {
      "const": "work"
    },
    "object_id": {
      "$ref": "../defs.json#/$defs/work_id"
    },
    "repo": {
      "$ref": "../defs.json#/$defs/repo_id"
    },
    "labels": {
      "$ref": "../defs.json#/$defs/labels"
    },
    "board": {
      "$ref": "../defs.json#/$defs/board_name"
    },
    "site": {
      "$ref": "../defs.json#/$defs/site_name"
    },
    "key": {
      "$ref": "../defs.json#/$defs/key"
    },
    "phase": {
      "$ref": "../defs.json#/$defs/phase"
    },
    "actor": {
      "$ref": "../defs.json#/$defs/actor"
    },
    "event": {
      "enum": [
        "link",
        "unlink"
      ]
    },
    "pr_ids": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/pr_id"
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "additionalProperties": false,
  "required": [
    "tool",
    "hook",
    "event_id",
    "object_type",
    "object_id",
    "repo",
    "labels",
    "board",
    "site",
    "key",
    "phase",
    "actor",
    "event",
    "pr_ids"
  ]
}
