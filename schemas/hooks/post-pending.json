{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticket-work/hooks/post-pending.json",
  "title": "post-pending hook payload (stdin)",
  "description": "post- hook payload (stdin): delivered at least once through the outbox; deduplicate on event_id; failure is never fatal. No ticket, pull request or model text. Consumers tolerate unknown keys.",
  "type": "object",
  "properties": {
    "tool": {
      "const": "ticket-work"
    },
    "hook": {
      "const": "post-pending"
    },
    "event_id": {
      "$ref": "../defs.json#/$defs/event_id"
    },
    "object_type": {
      "const": "work"
    },
    "object_id": {
      "$ref": "../defs.json#/$defs/work_id"
    },
    "repo": {
      "$ref": "../defs.json#/$defs/repo_id"
    },
    "labels": {
      "$ref": "../defs.json#/$defs/work_labels"
    },
    "board": {
      "$ref": "../defs.json#/$defs/board_name"
    },
    "site": {
      "$ref": "../defs.json#/$defs/site_name"
    },
    "key": {
      "$ref": "../defs.json#/$defs/key"
    },
    "phase": {
      "$ref": "../defs.json#/$defs/phase"
    },
    "actor": {
      "$ref": "../defs.json#/$defs/actor"
    },
    "decision_ids": {
      "$ref": "../defs.json#/$defs/decision_ids"
    },
    "pending_id": {
      "$ref": "../defs.json#/$defs/pending_id"
    },
    "action": {
      "$ref": "../defs.json#/$defs/pending_action"
    },
    "event": {
      "oneOf": [
        {
          "$ref": "../defs.json#/$defs/event_name"
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 1024,
      "description": "Trusted text built by ticket-work."
    },
    "expires": {
      "$ref": "../defs.json#/$defs/ts"
    },
    "dedupe_key": {
      "$ref": "../defs.json#/$defs/dedupe_key"
    }
  },
  "additionalProperties": false,
  "required": [
    "tool",
    "hook",
    "event_id",
    "object_type",
    "object_id",
    "repo",
    "labels",
    "board",
    "site",
    "key",
    "phase",
    "actor",
    "decision_ids",
    "pending_id",
    "action",
    "event",
    "summary",
    "expires",
    "dedupe_key"
  ]
}
